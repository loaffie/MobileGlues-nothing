+/**
+ * MobileGlues Nothing: presets, the two settings the patched renderer reads, and the way to the
+ * frame-time report. First on the page, because it is what this build is for.
+ */
+@Composable
+private fun NtTuningGroup(
+    controller: AppController,
+    config: MGConfig,
+    onPickBoost: () -> Unit,
+    onPickLogging: () -> Unit,
+) {
+    val context = LocalContext.current
+    val matching = controller.nothing.matchingPreset(config)
+
+    PreferenceGroup(title = stringResource(R.string.nt_group_tuning)) {
+        Column(modifier = Modifier.fillMaxWidth().padding(horizontal = 20.dp, vertical = 12.dp)) {
+            Text(
+                text = stringResource(R.string.nt_presets),
+                style = MaterialTheme.typography.bodyLarge,
+                color = MaterialTheme.colorScheme.onSurface,
+            )
+            FlowRow(
+                horizontalArrangement = Arrangement.spacedBy(8.dp),
+                verticalArrangement = Arrangement.spacedBy(8.dp),
+                modifier = Modifier.fillMaxWidth().padding(top = 10.dp),
+            ) {
+                NothingFeatures.Preset.entries.forEach { preset ->
+                    val label = stringResource(preset.labelRes)
+                    if (preset == matching) {
+                        Button(onClick = { controller.nothing.applyPreset(preset) }) { Text(label) }
+                    } else {
+                        OutlinedButton(onClick = { controller.nothing.applyPreset(preset) }) { Text(label) }
+                    }
+                }
+            }
+            Text(
+                text = matching?.let { stringResource(it.summaryRes) } ?: stringResource(R.string.nt_preset_custom),
+                style = MaterialTheme.typography.bodyMedium,
+                color = MaterialTheme.colorScheme.onSurfaceVariant,
+                modifier = Modifier.padding(top = 8.dp),
+            )
+        }
+        TextPreferenceRow(
+            title = stringResource(R.string.nt_boost_title),
+            summary = PerfHintTarget.label(context, config.perfHintFps) + " · " +
+                stringResource(R.string.nt_boost_hint),
+            onClick = onPickBoost,
+        )
+        TextPreferenceRow(
+            title = stringResource(R.string.nt_logging_title),
+            summary = config.hitchLog.label(context).toString(),
+            onClick = onPickLogging,
+        )
+        TextPreferenceRow(
+            title = stringResource(R.string.nt_report_title),
+            summary = stringResource(R.string.nt_report_summary),
+            onClick = { controller.openSubPage(AppSubPage.FrameTime) },
+        )
+        TextPreferenceRow(
+            title = stringResource(R.string.nt_share_title),
+            summary = stringResource(R.string.nt_share_summary),
+            onClick = controller.nothing::shareLog,
+        )
+    }
+}
