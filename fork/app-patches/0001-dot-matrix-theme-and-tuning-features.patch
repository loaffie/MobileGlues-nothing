+/**
+ * `hitchLog` (MobileGlues Nothing): how much of each frame the renderer times.
+ *
+ * Must match gl/frametime.cpp in the patched renderer: 0 off, 1 light (default), 2 full.
+ */
+enum class HitchLogLevel(override val wire: Int, @param:StringRes private val labelRes: Int) :
+    SpinnerOption {
+    Off(0, R.string.nt_hitch_off),
+    Light(1, R.string.nt_hitch_light),
+    Full(2, R.string.nt_hitch_full);
+
+    override fun label(context: Context): CharSequence = context.getString(labelRes)
+}
+
+/**
+ * `perfHintTargetFps` (MobileGlues Nothing): the frame rate the CPU performance hints aim for.
+ *
+ * 0 turns the hints off. The renderer clamps anything else to 20..240, so the app does too.
+ */
+object PerfHintTarget {
+    const val OFF = 0
+    const val DEFAULT = 120
+    val Choices = listOf(OFF, 60, 90, 120)
+
+    fun fromWire(wire: Int?): Int = when {
+        wire == null || wire < 0 -> DEFAULT
+        wire == 0 -> OFF
+        else -> wire.coerceIn(20, 240)
+    }
+
+    fun label(context: Context, fps: Int): String =
+        if (fps == OFF) context.getString(R.string.nt_boost_off) else context.getString(R.string.nt_boost_fps, fps)
+}
+
