diff --git a/app/src/main/java/com/fcl/plugin/mobileglues/ui/NothingFeatures.kt b/app/src/main/java/com/fcl/plugin/mobileglues/ui/NothingFeatures.kt
new file mode 100644
index 0000000..b6adcf0
--- /dev/null
+++ b/app/src/main/java/com/fcl/plugin/mobileglues/ui/NothingFeatures.kt
@@ -0,0 +1,158 @@
+package com.fcl.plugin.mobileglues.ui
+
+import android.content.Context
+import android.content.Intent
+import androidx.annotation.StringRes
+import androidx.core.content.FileProvider
+import com.fcl.plugin.mobileglues.R
+import com.fcl.plugin.mobileglues.settings.AngleConfig
+import com.fcl.plugin.mobileglues.settings.AuthController
+import com.fcl.plugin.mobileglues.settings.FrameTimeLog
+import com.fcl.plugin.mobileglues.settings.Fsr1Preset
+import com.fcl.plugin.mobileglues.settings.HitchLogLevel
+import com.fcl.plugin.mobileglues.settings.MGConfig
+import com.fcl.plugin.mobileglues.settings.MGConfigStore
+import com.fcl.plugin.mobileglues.settings.PerfHintTarget
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
+import java.io.File
+
+/**
+ * Everything MobileGlues Nothing adds on top of the upstream app: the two renderer settings
+ * of the patched build, one-tap presets, the frame-time report and sharing the log.
+ *
+ * Kept out of [AppController] so the upstream file only gains one line.
+ */
+class NothingFeatures(
+    private val context: Context,
+    private val configStore: MGConfigStore,
+    private val auth: AuthController,
+    private val scope: CoroutineScope,
+    private val snackbar: (CharSequence) -> Unit,
+) {
+
+    // ---- Renderer settings ----
+
+    fun setHitchLog(level: HitchLogLevel) = configStore.update { it.copy(hitchLog = level) }
+
+    fun setPerfHintFps(fps: Int) = configStore.update { it.copy(perfHintFps = PerfHintTarget.fromWire(fps)) }
+
+    // ---- Presets ----
+
+    enum class Preset(
+        @param:StringRes val labelRes: Int,
+        @param:StringRes val summaryRes: Int,
+        val apply: (MGConfig) -> MGConfig,
+    ) {
+        /** What the measurements on the Phone (3a) favoured: ANGLE, 120 fps hints, no timing. */
+        PvP(R.string.nt_preset_pvp, R.string.nt_preset_pvp_summary, {
+            it.copy(
+                angle = AngleConfig.EnableIfPossible,
+                perfHintFps = 120,
+                hitchLog = HitchLogLevel.Off,
+                fsr1 = Fsr1Preset.Disabled,
+            )
+        }),
+
+        /** Lets the CPU clock down: less heat on long sessions, at some cost in smoothness. */
+        Cooler(R.string.nt_preset_cooler, R.string.nt_preset_cooler_summary, {
+            it.copy(
+                angle = AngleConfig.EnableIfPossible,
+                perfHintFps = PerfHintTarget.OFF,
+                hitchLog = HitchLogLevel.Off,
+            )
+        }),
+
+        /** Full timing for a session whose log should be sent somewhere. Costs some frame rate. */
+        Diagnose(R.string.nt_preset_diagnose, R.string.nt_preset_diagnose_summary, {
+            it.copy(
+                perfHintFps = 120,
+                hitchLog = HitchLogLevel.Full,
+            )
+        }),
+    }
+
+    fun applyPreset(preset: Preset) {
+        configStore.update(preset.apply)
+        snackbar(context.getString(R.string.nt_preset_applied, context.getString(preset.labelRes)))
+    }
+
+    /** The preset the current config matches exactly, if any. */
+    fun matchingPreset(config: MGConfig): Preset? = Preset.entries.firstOrNull { it.apply(config) == config }
+
+    // ---- Frame-time report ----
+
+    sealed interface ReportState {
+        data object Loading : ReportState
+        data object NoAccess : ReportState
+        data object NoLog : ReportState
+        data class Ready(val report: FrameTimeLog.Report) : ReportState
+    }
+
+    private val mutableReport = MutableStateFlow<ReportState>(ReportState.Loading)
+    val report: StateFlow<ReportState> = mutableReport.asStateFlow()
+
+    fun loadReport() {
+        val storage = auth.state.value.storage
+        if (storage == null) {
+            mutableReport.value = ReportState.NoAccess
+            return
+        }
+        mutableReport.value = ReportState.Loading
+        scope.launch {
+            val parsed = withContext(Dispatchers.IO) { FrameTimeLog.parse(storage.readLog()) }
+            mutableReport.value = if (parsed == null) ReportState.NoLog else ReportState.Ready(parsed)
+        }
+    }
+
+    // ---- Sharing the log ----
+
+    fun shareLog() {
+        val storage = auth.state.value.storage
+        if (storage == null) {
+            snackbar(context.getString(R.string.nt_share_no_access))
+            return
+        }
+        scope.launch {
+            // Copied into the app's cache first: the log lives in /sdcard/MG (or behind a SAF
+            // grant), neither of which another app can be handed directly.
+            val uri = withContext(Dispatchers.IO) {
+                val text = storage.readLog() ?: return@withContext null
+                val dir = File(context.cacheDir, SHARE_DIR).apply { mkdirs() }
+                val file = File(dir, SHARE_FILE_NAME)
+                file.writeText(text)
+                runCatching {
+                    FileProvider.getUriForFile(context, "${context.packageName}$AUTHORITY_SUFFIX", file)
+                }.getOrNull()
+            }
+            if (uri == null) {
+                snackbar(context.getString(R.string.nt_share_no_log))
+                return@launch
+            }
+            val send = Intent(Intent.ACTION_SEND).apply {
+                type = "text/plain"
+                putExtra(Intent.EXTRA_STREAM, uri)
+                putExtra(Intent.EXTRA_SUBJECT, SHARE_FILE_NAME)
+                addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
+            }
+            val chooser = Intent.createChooser(send, context.getString(R.string.nt_share_title)).apply {
+                addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
+                addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
+            }
+            runCatching { context.startActivity(chooser) }
+                .onFailure { snackbar(context.getString(R.string.nt_share_failed)) }
+        }
+    }
+
+    companion object {
+        /** Must match the provider authority in AndroidManifest.xml. */
+        const val AUTHORITY_SUFFIX = ".share"
+        private const val SHARE_DIR = "shared"
+        private const val SHARE_FILE_NAME = "latest.log"
+    }
+}
