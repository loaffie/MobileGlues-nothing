diff --git a/app/src/main/java/com/fcl/plugin/mobileglues/settings/FrameTimeLog.kt b/app/src/main/java/com/fcl/plugin/mobileglues/settings/FrameTimeLog.kt
new file mode 100644
index 0000000..44b23a7
--- /dev/null
+++ b/app/src/main/java/com/fcl/plugin/mobileglues/settings/FrameTimeLog.kt
@@ -0,0 +1,122 @@
+package com.fcl.plugin.mobileglues.settings
+
+/**
+ * Reads the frame-pacing lines the patched renderer writes to `latest.log` (MobileGlues Nothing).
+ *
+ * The renderer (gl/frametime.cpp) writes, every 30 seconds:
+ *
+ *     [frametime] 3479 frames in 30 s | avg 8.63 ms (116 fps) | worst 48.8 ms | hitches 41
+ *     [frametime] all frames 30015 ms: swap 3.9% | multidraw 3.7% | ... | elsewhere 79.3%
+ *     [frametime] hitches    915 ms: swap 1.6% | multidraw 2.0% | ... | elsewhere 86.0%
+ *
+ * The two breakdown lines are only present on builds that time draw calls, so they are optional.
+ * Everything here is pure parsing: no Android, no I/O, never throws.
+ */
+object FrameTimeLog {
+
+    /** One 30 second window of play. */
+    data class Window(
+        val frames: Int,
+        val avgMs: Double,
+        val fps: Double,
+        val worstMs: Double,
+        val hitches: Int,
+        /** Share of all frame time per category, in percent. Empty on older builds. */
+        val breakdown: Map<String, Double>,
+        /** Same, over the hitches only. */
+        val hitchBreakdown: Map<String, Double>,
+    )
+
+    data class Report(
+        /** `enableAngle` as the renderer resolved it, or null when the log does not say. */
+        val angle: Boolean?,
+        /** First backend of `multidrawOrderElementsBaseVertex`: what Sodium's chunk draws use. */
+        val chunkDrawPath: String?,
+        /** The renderer's own line about the CPU performance hints. */
+        val perfHints: String?,
+        val hitchLogLevel: Int?,
+        val windows: List<Window>,
+    ) {
+        /**
+         * Windows that describe actual play. The first one includes loading into the world
+         * (a single 900 ms frame is normal there), so it is left out whenever there is anything else.
+         */
+        val playWindows: List<Window> get() = if (windows.size > 1) windows.drop(1) else windows
+
+        val medianFps: Double?
+            get() = playWindows.map { it.fps }.sorted().let { if (it.isEmpty()) null else it[it.size / 2] }
+
+        val worstMs: Double? get() = playWindows.maxOfOrNull { it.worstMs }
+
+        val hitchesPerSecond: Double?
+            get() = playWindows.takeIf { it.isNotEmpty() }?.let { w -> w.sumOf { it.hitches } / (w.size * 30.0) }
+
+        /** Average breakdown over the play windows that have one. */
+        val averageBreakdown: Map<String, Double>
+            get() {
+                val withData = playWindows.filter { it.breakdown.isNotEmpty() }
+                if (withData.isEmpty()) return emptyMap()
+                return Categories.associateWith { key ->
+                    withData.sumOf { it.breakdown[key] ?: 0.0 } / withData.size
+                }.filterValues { it > 0.0 }
+            }
+    }
+
+    /** Display order; also the order the renderer prints them in. */
+    val Categories = listOf(
+        "swap", "multidraw", "draw", "buffer", "map", "texture", "shader", "other-gl", "elsewhere",
+    )
+
+    private val summaryLine = Regex(
+        """\[frametime] (\d+) frames in 30 s \| avg ([\d.]+) ms \(([\d.]+) fps\) \| worst ([\d.]+) ms \| hitches (\d+)""",
+    )
+    private val breakdownLine = Regex("""\[frametime] (all frames|hitches)\s+[\d.]+ ms: (.*)$""")
+    private val breakdownItem = Regex("""([a-z-]+) ([\d.]+)%""")
+    private val angleLine = Regex("""Setting: enableAngle\s+= (true|false)""")
+    private val drawPathLine = Regex("""multidrawOrderElementsBaseVertex\s+= ([a-z]+)""")
+    private val hitchLogLine = Regex("""Setting: hitchLog\s+= (\d+)""")
+    private val perfHintLine = Regex("""perf hints: (.*)$""")
+
+    fun parse(text: String?): Report? {
+        if (text.isNullOrBlank()) return null
+        var angle: Boolean? = null
+        var drawPath: String? = null
+        var perfHints: String? = null
+        var hitchLog: Int? = null
+        val windows = mutableListOf<Window>()
+
+        for (line in text.lineSequence()) {
+            summaryLine.find(line)?.let { m ->
+                val (frames, avg, fps, worst, hitches) = m.destructured
+                windows += Window(
+                    frames = frames.toIntOrNull() ?: 0,
+                    avgMs = avg.toDoubleOrNull() ?: 0.0,
+                    fps = fps.toDoubleOrNull() ?: 0.0,
+                    worstMs = worst.toDoubleOrNull() ?: 0.0,
+                    hitches = hitches.toIntOrNull() ?: 0,
+                    breakdown = emptyMap(),
+                    hitchBreakdown = emptyMap(),
+                )
+                return@let
+            }
+            breakdownLine.find(line)?.let { m ->
+                val last = windows.lastOrNull() ?: return@let
+                val items = breakdownItem.findAll(m.groupValues[2])
+                    .associate { it.groupValues[1] to (it.groupValues[2].toDoubleOrNull() ?: 0.0) }
+                windows[windows.lastIndex] = if (m.groupValues[1] == "all frames") {
+                    last.copy(breakdown = items)
+                } else {
+                    last.copy(hitchBreakdown = items)
+                }
+                return@let
+            }
+            if (angle == null) angleLine.find(line)?.let { angle = it.groupValues[1] == "true" }
+            if (drawPath == null) drawPathLine.find(line)?.let { drawPath = it.groupValues[1] }
+            if (hitchLog == null) hitchLogLine.find(line)?.let { hitchLog = it.groupValues[1].toIntOrNull() }
+            if (perfHints == null) perfHintLine.find(line)?.let { perfHints = it.groupValues[1].trim() }
+        }
+
+        if (windows.isEmpty() && angle == null && drawPath == null) return null
+        return Report(angle, drawPath, perfHints, hitchLog, windows)
+    }
+}
