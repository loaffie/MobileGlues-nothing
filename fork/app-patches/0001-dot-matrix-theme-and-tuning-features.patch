+/**
+ * One column of dots per 30 second window, height proportional to its average FPS.
+ * The first window includes loading into the world and is drawn faded; a window whose
+ * worst frame passed 50 ms gets a red top dot.
+ */
+@Composable
+private fun FpsDotChart(windows: List<FrameTimeLog.Window>) {
+    val shown = windows.takeLast(MAX_CHART_COLUMNS)
+    val firstShownIsLoading = shown.size == windows.size && windows.size > 1
+    val peak = max(shown.maxOfOrNull { it.fps } ?: 1.0, 1.0)
+    val ink = MaterialTheme.colorScheme.onSurface
+    val faded = MaterialTheme.colorScheme.onSurface.copy(alpha = 0.25f)
+    val empty = MaterialTheme.colorScheme.onSurface.copy(alpha = 0.07f)
+    val red = MaterialTheme.colorScheme.tertiary
+
+    Column(modifier = Modifier.fillMaxWidth().padding(start = 16.dp, end = 16.dp, top = 16.dp, bottom = 8.dp)) {
+        Canvas(modifier = Modifier.fillMaxWidth().height((CHART_ROWS * 10).dp)) {
+            val columns = shown.size
+            val cell = min(size.width / max(columns, 1), size.height / CHART_ROWS)
+            val radius = cell * 0.32f
+            val left = (size.width - cell * columns) / 2f
+            shown.forEachIndexed { index, window ->
+                val lit = ((window.fps / peak) * CHART_ROWS).roundToInt().coerceIn(1, CHART_ROWS)
+                val colour = if (index == 0 && firstShownIsLoading) faded else ink
+                for (row in 0 until CHART_ROWS) {
+                    val center = Offset(
+                        x = left + cell * index + cell / 2f,
+                        y = size.height - cell * row - cell / 2f,
+                    )
+                    val on = row < lit
+                    val top = row == lit - 1
+                    val dot: Color = when {
+                        !on -> empty
+                        top && window.worstMs > 50.0 -> red
+                        else -> colour
+                    }
+                    drawCircle(color = dot, radius = radius, center = center)
+                }
+            }
+        }
+        Row(modifier = Modifier.fillMaxWidth().padding(top = 6.dp)) {
+            shown.forEach { window ->
+                Text(
+                    text = window.fps.roundToInt().toString(),
+                    style = MaterialTheme.typography.labelSmall,
+                    color = MaterialTheme.colorScheme.onSurfaceVariant,
+                    textAlign = TextAlign.Center,
+                    maxLines = 1,
+                    modifier = Modifier.weight(1f),
+                )
+            }
+        }
+    }
+}
+
+@Composable
+private fun BreakdownRow(label: String, share: Double, accent: Boolean) {
+    Row(
+        verticalAlignment = Alignment.CenterVertically,
+        modifier = Modifier.fillMaxWidth().padding(horizontal = 20.dp, vertical = 6.dp),
+    ) {
+        Text(
+            text = label,
+            style = MaterialTheme.typography.bodyMedium,
+            color = MaterialTheme.colorScheme.onSurface,
+            modifier = Modifier.width(132.dp),
+            maxLines = 1,
+        )
+        val ink = if (accent) MaterialTheme.colorScheme.tertiary else MaterialTheme.colorScheme.onSurface
+        val empty = MaterialTheme.colorScheme.onSurface.copy(alpha = 0.08f)
+        Canvas(modifier = Modifier.weight(1f).height(10.dp)) {
+            val cell = size.height
+            val count = (size.width / cell).toInt().coerceAtLeast(1)
+            val lit = ((share / 100.0) * count).roundToInt().coerceIn(if (share > 0.0) 1 else 0, count)
+            for (i in 0 until count) {
+                drawCircle(
+                    color = if (i < lit) ink else empty,
+                    radius = cell * 0.36f,
+                    center = Offset(cell * i + cell / 2f, cell / 2f),
+                )
+            }
+        }
+        Text(
+            text = String.format(Locale.US, "%.0f%%", share),
+            style = MaterialTheme.typography.labelLarge,
+            color = MaterialTheme.colorScheme.onSurfaceVariant,
+            textAlign = TextAlign.End,
+            modifier = Modifier.width(48.dp),
+        )
+    }
+}
+
+@Composable
+private fun categoryLabel(key: String): String = stringResource(
+    when (key) {
+        "swap" -> R.string.nt_cat_swap
+        "multidraw" -> R.string.nt_cat_multidraw
+        "draw" -> R.string.nt_cat_draw
+        "buffer" -> R.string.nt_cat_buffer
+        "map" -> R.string.nt_cat_map
+        "texture" -> R.string.nt_cat_texture
+        "shader" -> R.string.nt_cat_shader
+        "other-gl" -> R.string.nt_cat_other_gl
+        else -> R.string.nt_cat_elsewhere
+    },
+)
+
+private const val CHART_ROWS = 14
