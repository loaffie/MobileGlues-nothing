+/**
+ * MobileGlues Nothing: what the last game session's `latest.log` says about frame pacing.
+ */
+@Composable
+fun MaterialFrameTimePage(controller: AppController) {
+    val state by controller.nothing.report.collectAsStateWithLifecycle()
+
+    LaunchedEffect(Unit) { controller.nothing.loadReport() }
+
+    Column(modifier = Modifier.fillMaxSize()) {
+        Row(
+            verticalAlignment = Alignment.CenterVertically,
+            modifier = Modifier.fillMaxWidth().padding(horizontal = 4.dp, vertical = 4.dp),
+        ) {
+            IconButton(onClick = { controller.navigateBack() }) {
+                Icon(
+                    painter = painterResource(R.drawable.ic_arrow_back),
+                    contentDescription = stringResource(R.string.nav_back),
+                    tint = MaterialTheme.colorScheme.onSurface,
+                )
+            }
+            Text(
+                text = stringResource(R.string.nt_report_title),
+                style = MaterialTheme.typography.titleLarge,
+                color = MaterialTheme.colorScheme.onSurface,
+                modifier = Modifier.weight(1f).padding(start = 4.dp),
+            )
+            IconButton(onClick = { controller.nothing.loadReport() }) {
+                Icon(
+                    painter = painterResource(R.drawable.nt_ic_refresh),
+                    contentDescription = stringResource(R.string.nt_refresh),
+                    tint = MaterialTheme.colorScheme.onSurfaceVariant,
+                )
+            }
+            IconButton(onClick = { controller.nothing.shareLog() }) {
+                Icon(
+                    painter = painterResource(R.drawable.nt_ic_share),
+                    contentDescription = stringResource(R.string.nt_share_title),
+                    tint = MaterialTheme.colorScheme.onSurfaceVariant,
+                )
+            }
+        }
+
+        Column(
+            modifier = Modifier
+                .fillMaxSize()
+                .verticalScroll(rememberScrollState()),
+        ) {
+            when (val current = state) {
+                ReportState.Loading -> CenteredLoading(modifier = Modifier.padding(top = 48.dp))
+                ReportState.NoAccess -> EmptyNote(stringResource(R.string.nt_report_no_access))
+                ReportState.NoLog -> EmptyNote(stringResource(R.string.nt_report_no_log))
+                is ReportState.Ready -> ReportContent(controller, current.report)
+            }
+            BottomSpacer()
+        }
+    }
+}
+
+@Composable
+private fun EmptyNote(text: String) {
+    PreferenceGroup {
+        Text(
+            text = text,
+            style = MaterialTheme.typography.bodyLarge,
+            color = MaterialTheme.colorScheme.onSurfaceVariant,
+            modifier = Modifier.padding(20.dp),
+        )
+    }
+}
+
+@Composable
+private fun ReportContent(controller: AppController, report: FrameTimeLog.Report) {
+    // ---- What the renderer was running with ----
+    Row(
+        horizontalArrangement = Arrangement.spacedBy(8.dp),
+        modifier = Modifier.fillMaxWidth().padding(horizontal = ScreenPadding, vertical = 8.dp),
+    ) {
+        report.angle?.let { on ->
+            StatusChip(stringResource(if (on) R.string.nt_chip_angle_on else R.string.nt_chip_angle_off), on)
+        }
+        report.perfHints?.let { hints ->
+            val active = hints.startsWith("session created")
+            StatusChip(stringResource(if (active) R.string.nt_chip_boost_on else R.string.nt_chip_boost_off), active)
+        }
+        report.chunkDrawPath?.let { StatusChip(it, true) }
+    }
+
+    if (report.windows.isEmpty()) {
+        EmptyNote(stringResource(R.string.nt_report_logging_off))
+        return
+    }
+
+    // ---- Headline numbers ----
+    PreferenceGroup(title = stringResource(R.string.nt_report_session)) {
+        Row(modifier = Modifier.fillMaxWidth().padding(vertical = 16.dp)) {
+            BigStat(
+                value = report.medianFps?.roundToInt()?.toString() ?: "-",
+                label = stringResource(R.string.nt_stat_fps),
+                modifier = Modifier.weight(1f),
+            )
+            BigStat(
+                value = report.worstMs?.roundToInt()?.toString() ?: "-",
+                label = stringResource(R.string.nt_stat_worst),
+                modifier = Modifier.weight(1f),
+                accent = (report.worstMs ?: 0.0) > 50.0,
+            )
+            BigStat(
+                value = report.hitchesPerSecond?.let { String.format(Locale.US, "%.1f", it) } ?: "-",
+                label = stringResource(R.string.nt_stat_hitches),
+                modifier = Modifier.weight(1f),
+                accent = (report.hitchesPerSecond ?: 0.0) > 2.0,
+            )
+        }
+    }
+
+    // ---- FPS per 30 s window ----
+    PreferenceGroup(title = stringResource(R.string.nt_report_fps_chart)) {
+        FpsDotChart(report.windows)
+        Text(
+            text = stringResource(R.string.nt_report_fps_chart_note),
+            style = MaterialTheme.typography.bodySmall,
+            color = MaterialTheme.colorScheme.onSurfaceVariant,
+            modifier = Modifier.padding(start = 20.dp, end = 20.dp, bottom = 14.dp),
+        )
+    }
+
+    // ---- Where the time went ----
+    val breakdown = report.averageBreakdown
+    PreferenceGroup(title = stringResource(R.string.nt_report_breakdown)) {
+        if (breakdown.isEmpty()) {
+            Text(
+                text = stringResource(R.string.nt_report_breakdown_missing),
+                style = MaterialTheme.typography.bodyMedium,
+                color = MaterialTheme.colorScheme.onSurfaceVariant,
+                modifier = Modifier.padding(20.dp),
+            )
+        } else {
+            val outside = breakdown["elsewhere"] ?: 0.0
+            Text(
+                text = stringResource(
+                    if (outside >= 60.0) R.string.nt_verdict_game else R.string.nt_verdict_renderer,
+                    (100.0 - outside).roundToInt(),
+                ),
+                style = MaterialTheme.typography.bodyLarge,
+                color = MaterialTheme.colorScheme.onSurface,
+                modifier = Modifier.padding(start = 20.dp, end = 20.dp, top = 14.dp, bottom = 6.dp),
+            )
+            FrameTimeLog.Categories.forEach { key ->
+                val share = breakdown[key] ?: return@forEach
+                BreakdownRow(
+                    label = categoryLabel(key),
+                    share = share,
+                    accent = key != "elsewhere" && share >= 15.0,
+                )
+            }
+            Spacer(Modifier.height(10.dp))
+        }
+    }
+
+    Row(
+        horizontalArrangement = Arrangement.Center,
+        modifier = Modifier.fillMaxWidth().padding(top = 20.dp),
+    ) {
+        OutlinedButton(onClick = { controller.nothing.shareLog() }) {
+            Text(stringResource(R.string.nt_share_title))
+        }
+    }
+}
