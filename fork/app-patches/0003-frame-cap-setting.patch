+/**
+ * `frameCapFps` (MobileGlues Nothing): the renderer's own evenly paced frame cap.
+ *
+ * 0 is off. Meant to replace Minecraft's Max Framerate, which should then be Unlimited.
+ */
+object FrameCap {
+    const val OFF = 0
+    val Choices = listOf(OFF, 60, 90, 120)
+
+    fun fromWire(wire: Int?): Int = when {
+        wire == null || wire <= 0 -> OFF
+        else -> wire.coerceIn(20, 240)
+    }
+
+    fun label(context: Context, fps: Int): String =
+        if (fps == OFF) context.getString(R.string.nt_cap_off) else context.getString(R.string.nt_cap_fps, fps)
+}
