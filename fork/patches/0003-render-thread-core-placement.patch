+// ---------------------------------------------------------------------------
+// Render thread placement
+//
+// In Minecraft the thread that presents frames is the game's main thread: it
+// runs the game logic and issues every GL call. Measured on the Phone (3a) that
+// thread is about 80% of each frame outside this library, so where it runs
+// matters more than anything the renderer does.
+//
+// Android's guidance is to leave placement to the scheduler and send ADPF hints,
+// which this file also does. Elsewhere, scheduler and hints together have been
+// measured to leave a game's busiest thread on mid or little cores while the
+// fastest core idled. Asking for the fast cores explicitly fixed that on one
+// SoC and made things worse on another whose prime cores were clock-capped, so
+// this is a switch to A/B, off by default.
+//
+// The masks come from each core's cpuinfo_max_freq rather than from core
+// numbers, which differ per SoC. On the Snapdragon 7s Gen 3 (4x A520 1.8 GHz,
+// 3x A720 2.4 GHz, 1x A720 2.5 GHz) "big" is the four A720s and "prime" the one.
+// ---------------------------------------------------------------------------
+#ifdef __ANDROID__
+long read_cpu_max_khz(int cpu) {
+    char path[96];
+    std::snprintf(path, sizeof(path), "/sys/devices/system/cpu/cpu%d/cpufreq/cpuinfo_max_freq", cpu);
+    FILE* f = std::fopen(path, "r");
+    if (!f) return -1;
+    long khz = -1;
+    if (std::fscanf(f, "%ld", &khz) != 1) khz = -1;
+    std::fclose(f);
+    return khz;
+}
+
+thread_local bool t_pin_tried = false;
+
+void pin_render_thread_once() {
+    if (g_cfg_pin == 0 || t_pin_tried) return;
+    t_pin_tried = true;
+
+    const long ncpu = sysconf(_SC_NPROCESSORS_CONF);
+    if (ncpu <= 0 || ncpu > CPU_SETSIZE) return;
+    long maxes[CPU_SETSIZE];
+    long lo = -1, hi = -1;
+    for (int c = 0; c < ncpu; ++c) {
+        maxes[c] = read_cpu_max_khz(c);
+        if (maxes[c] <= 0) continue;
+        if (lo < 0 || maxes[c] < lo) lo = maxes[c];
+        if (hi < 0 || maxes[c] > hi) hi = maxes[c];
+    }
+    if (hi <= 0) {
+        LOG_V("[MobileGlues] render thread: core speeds unreadable, placement left to Android")
+        return;
+    }
+
+    cpu_set_t set;
+    CPU_ZERO(&set);
+    std::string chosen;
+    int count = 0;
+    for (int c = 0; c < ncpu; ++c) {
+        if (maxes[c] <= 0) continue;
+        // big: everything faster than the slowest cluster. On a SoC with a
+        // single speed that is nothing, so fall back to every core.
+        const bool take = (g_cfg_pin == 2) ? (maxes[c] == hi) : (maxes[c] > lo || lo == hi);
+        if (!take) continue;
+        CPU_SET(c, &set);
+        chosen += " " + std::to_string(c);
+        ++count;
+    }
+    if (count == 0) return;
+
+    if (sched_setaffinity(0, sizeof(set), &set) != 0) {
+        LOG_V("[MobileGlues] render thread: pinning to CPUs%s refused (%s)", chosen.c_str(), std::strerror(errno))
+        return;
+    }
+    LOG_V("[MobileGlues] render thread pinned to CPUs%s (%s, up to %ld MHz)", chosen.c_str(),
+          g_cfg_pin == 2 ? "prime" : "big", hi / 1000)
+}
+#else
+void pin_render_thread_once() {}
+#endif
