+// MobileGlues - egl/blobcache.cpp
+// Copyright (c) 2025-2026 MobileGL-Dev
+// Licensed under the GNU Lesser General Public License v2.1:
+//   https://www.gnu.org/licenses/old-licenses/lgpl-2.1.txt
+// SPDX-License-Identifier: LGPL-2.1-only
+// End of Source File Header
+
+#include "blobcache.h"
+#include "../config/config.h"
+#include "../config/settings.h"
+#include "../gl/log.h"
+#include "../gl/mg.h"
+#include "../gles/loader.h"
+#include "loader.h"
+
+#include <EGL/eglext.h>
+#include <atomic>
+#include <cerrno>
+#include <condition_variable>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <map>
+#include <mutex>
+#include <string>
+#include <sys/stat.h>
+#include <thread>
+#include <unistd.h>
+#include <vector>
+
+namespace {
+
+// File layout: magic, key size, value size, key, value. The key is stored so a file name
+// collision is a miss and not somebody else's data.
+constexpr uint32_t kMagic = 0x4342474Du; // "MGBC"
+constexpr size_t kMaxValue = 48u * 1024u * 1024u;
+constexpr int kMaxLoggedEvents = 24;
+
+std::string g_dir;
+std::atomic<int> g_logged{0};
+std::atomic<uint64_t> g_hits{0};
+std::atomic<uint64_t> g_misses{0};
+std::atomic<uint64_t> g_saved{0};
+
+struct Pending {
+    std::string name;
+    std::vector<unsigned char> bytes; // the whole file, ready to write
+};
+
+// Never destroyed. The writer thread sleeps on the condition variable for the life of the
+// process, and destroying a condition variable somebody is waiting on blocks forever in
+// glibc, so the usual static destructors at exit would hang the game's shutdown.
+struct Shared {
+    std::mutex mutex;
+    std::condition_variable wake;
+    std::map<std::string, Pending> pending; // newest write per file wins
+    bool writer_started = false;
+};
+Shared& shared() {
+    static Shared* s = new Shared();
+    return *s;
+}
+
+uint64_t fnv1a(const unsigned char* p, size_t n) {
+    uint64_t h = 1469598103934665603ull;
+    for (size_t i = 0; i < n; ++i) {
+        h ^= p[i];
+        h *= 1099511628211ull;
+    }
+    return h;
+}
+
+std::string name_for(const void* key, size_t size) {
+    char buf[24];
+    std::snprintf(buf, sizeof(buf), "%016llx", static_cast<unsigned long long>(fnv1a(static_cast<const unsigned char*>(key), size)));
+    return std::string(buf);
+}
+
+void log_event(const char* what, const std::string& name, size_t bytes) {
+    if (g_logged.fetch_add(1) < kMaxLoggedEvents) {
+        LOG_V("[angle-cache] %s %s (%.1f KB)", what, name.c_str(), static_cast<double>(bytes) / 1024.0)
+    }
+}
+
+void write_file(const Pending& p) {
+    const std::string path = g_dir + "/" + p.name;
+    const std::string tmp = path + ".tmp";
+    FILE* f = std::fopen(tmp.c_str(), "wb");
+    if (!f) return;
+    const bool ok = std::fwrite(p.bytes.data(), 1, p.bytes.size(), f) == p.bytes.size();
+    const bool closed = std::fclose(f) == 0;
+    if (!(ok && closed) || std::rename(tmp.c_str(), path.c_str()) != 0) {
+        std::remove(tmp.c_str());
+        return;
+    }
+    g_saved.fetch_add(1);
+    log_event("saved", p.name, p.bytes.size());
+}
+
+void writer_main() {
+    std::unique_lock<std::mutex> lock(shared().mutex);
+    for (;;) {
+        shared().wake.wait(lock, [] { return !shared().pending.empty(); });
+        auto it = shared().pending.begin();
+        Pending job = std::move(it->second);
+        shared().pending.erase(it);
+        lock.unlock();
+        write_file(job);
+        lock.lock();
+    }
+}
+
+// EGLSetBlobFuncANDROID
+void set_blob(const void* key, EGLsizeiANDROID key_size, const void* value, EGLsizeiANDROID value_size) {
+    if (!key || !value || key_size <= 0 || value_size <= 0 || static_cast<size_t>(value_size) > kMaxValue) return;
+    Pending p;
+    p.name = name_for(key, static_cast<size_t>(key_size));
+    const uint32_t header[3] = {kMagic, static_cast<uint32_t>(key_size), static_cast<uint32_t>(value_size)};
+    p.bytes.resize(sizeof(header) + static_cast<size_t>(key_size) + static_cast<size_t>(value_size));
+    std::memcpy(p.bytes.data(), header, sizeof(header));
+    std::memcpy(p.bytes.data() + sizeof(header), key, static_cast<size_t>(key_size));
+    std::memcpy(p.bytes.data() + sizeof(header) + static_cast<size_t>(key_size), value, static_cast<size_t>(value_size));
+    {
+        std::lock_guard<std::mutex> lock(shared().mutex);
+        shared().pending[p.name] = std::move(p);
+    }
+    shared().wake.notify_one();
+}
+
+// EGLGetBlobFuncANDROID. Returns the size of the entry, or 0 if there is none. The value is
+// copied only if the caller's buffer is large enough.
+EGLsizeiANDROID get_blob(const void* key, EGLsizeiANDROID key_size, void* value, EGLsizeiANDROID value_size) {
+    if (!key || key_size <= 0) return 0;
+    const std::string name = name_for(key, static_cast<size_t>(key_size));
+
+    // A write that has not reached the disk yet is still the newest answer.
+    {
+        std::lock_guard<std::mutex> lock(shared().mutex);
+        auto it = shared().pending.find(name);
+        if (it != shared().pending.end()) {
+            const std::vector<unsigned char>& b = it->second.bytes;
+            const size_t off = 3 * sizeof(uint32_t) + static_cast<size_t>(key_size);
+            const size_t size = b.size() - off;
+            if (value && static_cast<size_t>(value_size) >= size) std::memcpy(value, b.data() + off, size);
+            return static_cast<EGLsizeiANDROID>(size);
+        }
+    }
+
+    FILE* f = std::fopen((g_dir + "/" + name).c_str(), "rb");
+    if (!f) {
+        g_misses.fetch_add(1);
+        return 0;
+    }
+    uint32_t header[3];
+    EGLsizeiANDROID result = 0;
+    if (std::fread(header, sizeof(header), 1, f) == 1 && header[0] == kMagic &&
+        header[1] == static_cast<uint32_t>(key_size) && header[2] > 0 && header[2] <= kMaxValue) {
+        std::vector<unsigned char> stored(header[1]);
+        if (std::fread(stored.data(), 1, stored.size(), f) == stored.size() &&
+            std::memcmp(stored.data(), key, stored.size()) == 0) {
+            result = static_cast<EGLsizeiANDROID>(header[2]);
+            if (value && value_size >= result) {
+                if (std::fread(value, 1, header[2], f) != header[2]) result = 0;
+            }
+        }
+    }
+    std::fclose(f);
+    if (result > 0) {
+        g_hits.fetch_add(1);
+        if (value && value_size >= result) log_event("hit", name, static_cast<size_t>(result));
+    } else {
+        g_misses.fetch_add(1);
+    }
+    return result;
+}
+
+} // namespace
+
+void mg_angle_install_blob_cache(EGLDisplay dpy) {
+    if (dpy == EGL_NO_DISPLAY) return;
+    if (global_settings.angle != AngleMode::Enabled) return;
+    if (config_get_int(const_cast<char*>("angleBlobCache")) == 0) return;
+
+    // Once per display: ANGLE refuses a second set, and a refused EGL call would leave an
+    // error behind for the application's next eglGetError to find.
+    static std::mutex seen_mutex;
+    static std::vector<EGLDisplay> seen;
+    {
+        std::lock_guard<std::mutex> lock(seen_mutex);
+        for (EGLDisplay d : seen)
+            if (d == dpy) return;
+        seen.push_back(dpy);
+    }
+
+    LOAD_EGL(eglQueryString)
+    if (!egl_eglQueryString) return;
+    const char* ext = egl_eglQueryString(dpy, EGL_EXTENSIONS);
+    if (!ext || !std::strstr(ext, "EGL_ANDROID_blob_cache")) {
+        LOG_V("[angle-cache] not available: ANGLE does not offer EGL_ANDROID_blob_cache")
+        return;
+    }
+
+    typedef void (*set_funcs_t)(EGLDisplay, EGLSetBlobFuncANDROID, EGLGetBlobFuncANDROID);
+    set_funcs_t set_funcs = (egl != NULL) ? reinterpret_cast<set_funcs_t>(proc_address(egl, "eglSetBlobCacheFuncsANDROID")) : nullptr;
+    if (!set_funcs) {
+        LOAD_EGL(eglGetProcAddress)
+        if (egl_eglGetProcAddress)
+            set_funcs = reinterpret_cast<set_funcs_t>(egl_eglGetProcAddress("eglSetBlobCacheFuncsANDROID"));
+    }
+    if (!set_funcs) {
+        LOG_V("[angle-cache] not available: eglSetBlobCacheFuncsANDROID not found")
+        return;
+    }
+
+    if (!mg_directory_path) return;
+    g_dir = std::string(mg_directory_path) + "/angle_cache";
+    if (mkdir(g_dir.c_str(), 0755) != 0 && errno != EEXIST) {
+        LOG_V("[angle-cache] not available: cannot create %s", g_dir.c_str())
+        return;
+    }
+
+    {
+        std::lock_guard<std::mutex> lock(shared().mutex);
+        if (!shared().writer_started) {
+            shared().writer_started = true;
+            std::thread(writer_main).detach();
+        }
+    }
+    set_funcs(dpy, set_blob, get_blob);
+    LOG_V("[angle-cache] pipelines are kept in %s", g_dir.c_str())
+}
