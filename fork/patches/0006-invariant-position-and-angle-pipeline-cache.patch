@@ -0,0 +1,90 @@
+// MobileGlues - gl/glsl/spirv_invariant.h
+// Copyright (c) 2025-2026 MobileGL-Dev
+// Licensed under the GNU Lesser General Public License v2.1:
+//   https://www.gnu.org/licenses/old-licenses/lgpl-2.1.txt
+// SPDX-License-Identifier: LGPL-2.1-only
+// End of Source File Header
+
+#ifndef MOBILEGLUES_SPIRV_INVARIANT_H
+#define MOBILEGLUES_SPIRV_INVARIANT_H
+
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+// Makes the vertex position of a vertex-stage SPIR-V module invariant.
+//
+// Minecraft draws the same block face with different programs: Sodium compiles one
+// vertex shader per render pass (solid, cutout, translucent). Decals such as leaf
+// litter and the grass under them are then positioned by two separately compiled
+// copies of the same arithmetic. A mobile GPU compiler is free to contract a
+// multiply and an add into one fused operation in one copy and not the other, so
+// the two depths can differ in the last bits and the surfaces fight over the pixel.
+// On the desktop drivers the game is written for this does not happen in practice.
+// The `invariant` qualifier is the language's way of asking for the same result
+// from every program that computes the same expression.
+//
+// This adds the Invariant decoration next to the BuiltIn Position decoration. If
+// the shader already has it, or there is no position output, nothing changes.
+// Returns true if the module was changed.
+inline bool mg_spirv_mark_position_invariant(std::vector<unsigned int>& spv) {
+    constexpr uint32_t kMagic = 0x07230203u;
+    constexpr uint32_t kOpDecorate = 71;
+    constexpr uint32_t kOpMemberDecorate = 72;
+    constexpr uint32_t kDecorationBuiltIn = 11;
+    constexpr uint32_t kDecorationInvariant = 18;
+    constexpr uint32_t kBuiltInPosition = 0;
+
+    if (spv.size() < 5 || spv[0] != kMagic) return false;
+
+    struct Marked {
+        uint32_t id;
+        uint32_t member;
+        bool is_member;
+    };
+    std::vector<Marked> already;
+    bool found = false;
+    Marked pos{0, 0, false};
+    size_t insert_at = 0;
+
+    for (size_t i = 5; i < spv.size();) {
+        const uint32_t op = spv[i] & 0xFFFFu;
+        const uint32_t wc = spv[i] >> 16;
+        if (wc == 0 || i + wc > spv.size()) return false; // malformed: leave it alone
+        if (op == kOpDecorate && wc >= 3) {
+            const uint32_t dec = spv[i + 2];
+            if (dec == kDecorationInvariant) {
+                already.push_back({spv[i + 1], 0, false});
+            } else if (dec == kDecorationBuiltIn && wc >= 4 && spv[i + 3] == kBuiltInPosition && !found) {
+                found = true;
+                pos = {spv[i + 1], 0, false};
+                insert_at = i + wc;
+            }
+        } else if (op == kOpMemberDecorate && wc >= 4) {
+            const uint32_t dec = spv[i + 3];
+            if (dec == kDecorationInvariant) {
+                already.push_back({spv[i + 1], spv[i + 2], true});
+            } else if (dec == kDecorationBuiltIn && wc >= 5 && spv[i + 4] == kBuiltInPosition && !found) {
+                found = true;
+                pos = {spv[i + 1], spv[i + 2], true};
+                insert_at = i + wc;
+            }
+        }
+        i += wc;
+    }
+
+    if (!found) return false;
+    for (const Marked& m : already)
+        if (m.id == pos.id && m.is_member == pos.is_member && (!m.is_member || m.member == pos.member)) return false;
+
+    if (pos.is_member) {
+        const unsigned int words[4] = {(4u << 16) | kOpMemberDecorate, pos.id, pos.member, kDecorationInvariant};
+        spv.insert(spv.begin() + static_cast<std::ptrdiff_t>(insert_at), words, words + 4);
+    } else {
+        const unsigned int words[3] = {(3u << 16) | kOpDecorate, pos.id, kDecorationInvariant};
+        spv.insert(spv.begin() + static_cast<std::ptrdiff_t>(insert_at), words, words + 3);
+    }
+    return true;
+}
+
+#endif // MOBILEGLUES_SPIRV_INVARIANT_H
