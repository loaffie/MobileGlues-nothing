+// MobileGlues - egl/blobcache.h
+// Copyright (c) 2025-2026 MobileGL-Dev
+// Licensed under the GNU Lesser General Public License v2.1:
+//   https://www.gnu.org/licenses/old-licenses/lgpl-2.1.txt
+// SPDX-License-Identifier: LGPL-2.1-only
+// End of Source File Header
+
+#ifndef MOBILEGLUES_BLOBCACHE_H
+#define MOBILEGLUES_BLOBCACHE_H
+
+#include <EGL/egl.h>
+
+// Keeps ANGLE's compiled pipelines between launches.
+//
+// ANGLE's Vulkan backend compiles a pipeline the first time a draw needs one, and the
+// calling thread waits for it. Those waits show up in the frame log as a long glDrawArrays
+// or glDrawElements. ANGLE can save what it compiled through EGL_ANDROID_blob_cache, but
+// only if the application provides the storage, and nothing here did, so every launch
+// started cold. This provides it: one file per entry under <MG dir>/angle_cache, written
+// from a background thread.
+//
+// Call it on a display that is initialised and has no context yet. It does nothing unless
+// ANGLE is the backend, and it stops at the first thing it cannot do. "angleBlobCache": 0
+// in config.json turns it off.
+void mg_angle_install_blob_cache(EGLDisplay dpy);
+
+#endif // MOBILEGLUES_BLOBCACHE_H
