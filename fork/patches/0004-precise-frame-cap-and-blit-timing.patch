+// ---------------------------------------------------------------------------
+// Frame cap
+//
+// Minecraft has a frame limiter of its own, but it waits through the launcher's
+// GLFW, and on the Phone (3a) a capped session lost three times as much time to
+// long frames as an uncapped one. This one waits in the swap path instead: a
+// plain sleep for the bulk of the wait, then a short yield loop for the last
+// stretch, because a sleep on Android routinely wakes a millisecond or more late.
+//
+// Frames are released on a fixed grid (last slot + period), so the rate is even
+// and averages exactly the cap. A frame that misses its slot by more than a whole
+// period restarts the grid instead of being followed by a burst of catch-up frames.
+//
+// Meant to be used with Minecraft's own Max Framerate set to Unlimited, so only
+// one limiter is ever in play.
+// ---------------------------------------------------------------------------
+namespace {
+thread_local uint64_t t_pace_slot = 0;
+
+void sleep_until_ns(uint64_t target_ns) {
+    const uint64_t SPIN_NS = 1500000; // last 1.5 ms: yield instead of sleeping
+    for (;;) {
+        const uint64_t now = mg_ft_now();
+        if (now >= target_ns) return;
+        const uint64_t left = target_ns - now;
+        if (left > SPIN_NS) {
+            const uint64_t wake = now + (left - SPIN_NS);
+            timespec ts;
+            ts.tv_sec = static_cast<time_t>(wake / 1000000000ull);
+            ts.tv_nsec = static_cast<long>(wake % 1000000000ull);
+            // mg_ft_now() is steady_clock, which is CLOCK_MONOTONIC on Linux and Android.
+            clock_nanosleep(CLOCK_MONOTONIC, TIMER_ABSTIME, &ts, nullptr);
+        } else {
+            sched_yield();
+        }
+    }
+}
+} // namespace
+
+void mg_frame_pace() {
+    read_config_once();
+    if (g_cfg_frame_cap <= 0) return;
+    const uint64_t period = 1000000000ull / static_cast<uint64_t>(g_cfg_frame_cap);
+    const uint64_t now = mg_ft_now();
+    if (t_pace_slot == 0) {
+        t_pace_slot = now;
+        return;
+    }
+    const uint64_t target = t_pace_slot + period;
+    if (now < target) {
+        sleep_until_ns(target);
+        const uint64_t waited = mg_ft_now() - now;
+        g_mg_ft_frame.ns[MG_FT_PACE] += waited;
+        g_mg_ft_frame.calls[MG_FT_PACE] += 1;
+        t_pace_slot = target;
+    } else {
+        t_pace_slot = (now - target > period) ? now : target;
+    }
+}
+
 void mg_frame_presented() {
     read_config_once();
     pin_render_thread_once();
